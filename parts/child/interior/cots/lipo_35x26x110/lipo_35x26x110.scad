// =====================================================================
// lipo_35x26x110.scad — 子機用 LiPo (製品名・容量 要確認, 2026-09-03 ユーザー指定)
//
// 購入品だがベンダの 3D データが無いため、指定寸法から自作した確認用モデル。
// 印刷対象ではない (アセンブリの干渉確認とベイ寸法決定に使う)。
//
// 出典: ユーザー指定 2026-09-03。外形 110(長さ) x 35(幅) x 26(厚み) mm。
//       製品名・容量・質量は要確認。
//
// 原点: 左手前下の角 (0,0,0)。X=長さ110 (cell_l) / Y=幅35 (cell_w) / Z=厚み26 (cell_h)。
//       リードは両方とも +X 端面から出る (35mm 辺の両端寄り、Z 中央)。
//
// バリアント (variants.txt):
//   pack  … セル本体のみ。ベイ内寸を決めるのはこちら
//   leads … 本体 + リードスタブ (充電用 / 電源用) の干渉確認用
//
// Fusion編集用に cube のみ (角丸は付けない — CLAUDE.md 規約)。
// =====================================================================

/* [セル本体 (指定値)] */
cell_l    = 110;   // 長さ (X)
cell_w    = 35;    // 幅   (Y)
cell_h    = 26;    // 厚み (Z)
tol       = 0;     // 製造ばらつき。ベイ側で吸収するのでモデルは 0 のまま使う

/* [リードスタブ (簡易表現)]  実際のリード形状は要確認。ここでは占有ゾーンとして cube スタブで表現 */
show_leads   = false;  // true でリードスタブを付ける (leads バリアント)
lead_edge    = 4.5;    // 35mm 辺の端からリード中心までの距離
lead_d       = 4;      // スタブの一辺 (角断面で近似)
lead_stub_l  = 8;      // +X 方向への突き出し長さ

$fn = 32;

// ---- 導出 -----------------------------------------------------------
bl = cell_l + tol;
bw = cell_w + tol;
bh = cell_h + tol;

// 充電用リード中心 (Y)
lead_chg_y = lead_edge;
// 電源用リード中心 (Y)
lead_pwr_y = bw - lead_edge;
// リード共通 Z 中心
lead_z = bh / 2;

// ---- 成立性チェック --------------------------------------------------
// リードスタブがセル幅の内側に収まっていること (端面からはみ出すと宙に浮く)
assert(lead_edge + lead_d / 2 < bw / 2,
       str("リードスタブ (edge=", lead_edge, " d=", lead_d,
           ") がセル幅 ", bw, " の中心線を超過"));
// パックとして辻褄が合う体積か (概ね 60cm^3 以上)
assert(bl * bw * bh > 60000,
       "セル外形が子機用 LiPo として小さすぎる — 寸法の取り違えを疑うこと");

// ---- 本体 -------------------------------------------------------------
union() {
    // セル本体 (熱収縮チューブ外形)
    cube([bl, bw, bh]);

    // リードスタブ (充電用 / 電源用、いずれも +X 端面から突き出す)
    if (show_leads) {
        translate([bl, lead_chg_y - lead_d / 2, lead_z - lead_d / 2])
            cube([lead_stub_l, lead_d, lead_d]);
        translate([bl, lead_pwr_y - lead_d / 2, lead_z - lead_d / 2])
            cube([lead_stub_l, lead_d, lead_d]);
    }
}

echo(str("lipo_35x26x110: ", bl, " x ", bw, " x ", bh,
         show_leads ? str("  +リードスタブ ", lead_stub_l) : "",
         "  全長 ", bl + (show_leads ? lead_stub_l : 0)));
