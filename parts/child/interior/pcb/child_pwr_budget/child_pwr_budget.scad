// =====================================================================
// child_pwr_budget.scad — CHILD_PWR (縮小版) に許される外形の「予算」
//
// **基板ではない。機体側から KiCad 側へ返す外形制約そのもの。**
// 200mm チューブの縦置き内装 (A案: CHILD_PWR を縮小する) で、
// CHILD_PWR が占めてよい空間の上限を立体にしたもの。
// この中に収まる基板を KiCad で設計すれば、機体側の変更なしで収まる。
//
// 根拠は docs/子機内装_収まり検討.md §4。現行 CHILD_PWR は 100.35 x 70 で、
// 幅広部 (Ø101.6 / 軸方向 160mm) に CHILD_MAIN (112) と並べて入らない。
//
// 段付きになっているのは、基板の**先端 10mm が上フランジの貫通口 (Ø88.5) へ
// はみ出す**ため。そこだけ低背にする必要がある。
//
// 座標は他の基板モデルと同じ並び:
//   X = 0..56  … 軸方向 (チューブ Z 方向へ写る)。X=0 が下 (CHILD_MAIN 側)
//   Y = -70..0 … 幅方向 (機体 X 方向へ写る)
//   Z          … 高さ。基板下面が Z=0、部品が +Z、裏面リードが -Z
//
// 印刷対象ではない (確認用モデル)。
// =====================================================================

/* [外形の予算] */
pwr_l      = 56;      // 軸方向の長さ (上限)
pwr_w      = 70;      // 幅 (現行と同じ。これ以上広げられない)
pcb_t      = 1.6;

/* [高さの予算 (基板下面から)] */
wide_l     = 46;      // X=0..46 は幅広部 (Ø101.6) の中 → 高さに余裕がある
wide_h     = 25.1;    // その範囲の最大部品高さ (現行 CHILD_PWR と同じ = 変更不要)
tip_h      = 21.0;    // X=46..56 は貫通口 (Ø88.5) の中 → ここだけ低背にすること
under_h    = 8.2;     // 裏面リードの突出 (現行と同じ)

/* [取付穴 (四隅 inset)] */
hole_in    = 2.4;     // 基板端からの inset
hole_d     = 3.2;     // M3 クリアランス

$fn = 32;

// ---- 導出 -------------------------------------------------------------
tip_l  = pwr_l - wide_l;
hx     = [hole_in, pwr_l - hole_in];              // 取付穴 X
hy     = [-hole_in, -(pwr_w - hole_in)];          // 取付穴 Y
pitch_x = hx[1] - hx[0];
pitch_y = abs(hy[1] - hy[0]);

// ---- 成立性チェック ---------------------------------------------------
assert(tip_l > 0, str("wide_l ", wide_l, " が pwr_l ", pwr_l, " 以上"));
assert(tip_h < wide_h, "先端側の高さ予算が幅広部側より大きい — 段の意味がない");
assert(hole_in * 2 < pwr_w && hole_in * 2 < pwr_l, "取付穴の inset が外形より大きい");
// 取付穴は幅広部側/先端側の両方の端に来るので、段の境界にかからないこと
for (x = hx) assert(abs(x - wide_l) > hole_d, "取付穴が高さの段の境界にかかっている");

// ---- 本体 -------------------------------------------------------------
difference() {
    union() {
        // 幅広部にある範囲
        translate([0, -pwr_w, -under_h]) cube([wide_l, pwr_w, under_h + wide_h]);
        // 貫通口へ出る先端 (低背)
        translate([wide_l, -pwr_w, -under_h]) cube([tip_l, pwr_w, under_h + tip_h]);
    }
    // 取付穴 (位置の確認用に貫通させる)
    for (x = hx) for (y = hy)
        translate([x, y, -under_h - 1]) cylinder(d = hole_d, h = under_h + wide_h + 2);
}

echo(str("child_pwr_budget: ", pwr_l, " x ", pwr_w,
         "  面積 ", pwr_l * pwr_w, " mm^2 (現行 CHILD_PWR は ", 100.35 * 70, ")",
         "  高さ 0..", wide_l, " → ", wide_h, " / ", wide_l, "..", pwr_l, " → ", tip_h,
         "  裏面 ", under_h,
         "  取付穴ピッチ ", pitch_x, " x ", pitch_y));
