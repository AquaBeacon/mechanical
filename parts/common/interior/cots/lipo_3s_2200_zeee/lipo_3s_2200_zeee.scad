// =====================================================================
// lipo_3s_2200_zeee.scad — Zeee 3S 11.1V 2200mAh 50C (実購入品の簡易モデル)
//
// 購入品だがベンダの 3D データが無いため、公称寸法から自作した確認用モデル。
// 印刷対象ではない (アセンブリの干渉確認とベイ寸法決定に使う)。
//
// 出典: docs/未踏ジュニア購入物品.xlsx (2026-07-22 購入 / Amazon B07QKR6DRL,
//       2本入りで親機・子機に1本ずつ)。寸法 102 x 34 x 23mm ±2mm / 約170g。
//       放電コネクタ = T(ディーンズ)プラグ + XT60 変換ケーブル同梱、
//       バランスコネクタ = JST-XH 4P。
//
// 原点: 左手前下の角 (0,0,0)。X=長さ102 / Y=幅34 / Z=高さ23。
//       リード線は +X 端面から出る。
//
// バリアント (variants.txt):
//   pack … セル本体のみ。ベイ内寸を決めるのはこちら
//   env  … 本体 + リード/コネクタ余裕ゾーン。配線スペースの確保確認用
//
// Fusion編集用に cube のみ (角丸は付けない — CLAUDE.md 規約)。
// =====================================================================

/* [セル本体 (公称)] */
cell_l    = 102;   // 長さ (X)
cell_w    = 34;    // 幅   (Y)
cell_h    = 23;    // 高さ (Z)
tol       = 0;     // 公称に対する製造ばらつき (データシート ±2mm)。
                   // ベイ側で吸収するのでモデルは 0 のまま使う

/* [リード/コネクタ余裕ゾーン] */
show_leads  = false;  // true でリード側の余裕ゾーンを付ける (env バリアント)
lead_zone_l = 40;     // +X 端面から必要な長さ (曲げ + プラグ + 抜き差し)
lead_zone_w = 26;     // 幅 (放電2本 + バランス1本を束ねた帯)
lead_zone_h = 16;     // 高さ

$fn = 32;

// ---- 導出 -----------------------------------------------------------
bl = cell_l + tol;
bw = cell_w + tol;
bh = cell_h + tol;
lz_y0 = (bw - lead_zone_w) / 2;   // 余裕ゾーンを幅方向で中央に
lz_z0 = (bh - lead_zone_h) / 2;   // 同じく高さ方向で中央に

// ---- 成立性チェック --------------------------------------------------
// 余裕ゾーンはセル端面からはみ出さないこと (はみ出すとゾーンが宙に浮く)
assert(lead_zone_w <= bw + 0.01,
       str("リード余裕ゾーン幅 ", lead_zone_w, " がセル幅 ", bw, " を超過"));
assert(lead_zone_h <= bh + 0.01,
       str("リード余裕ゾーン高さ ", lead_zone_h, " がセル高さ ", bh, " を超過"));
// 3S パックとして辻褄が合う体積か (セル3本ぶん = 概ね 60cm^3 以上)
assert(bl * bw * bh > 60000,
       "セル外形が 3S 2200mAh として小さすぎる — 寸法の取り違えを疑うこと");

// ---- 本体 -------------------------------------------------------------
union() {
    // セル本体 (熱収縮チューブ外形)
    cube([bl, bw, bh]);

    // リード線 + プラグの占有ゾーン (干渉確認用)
    if (show_leads)
        translate([bl, lz_y0, lz_z0])
            cube([lead_zone_l, lead_zone_w, lead_zone_h]);
}

echo(str("lipo_3s_2200_zeee: ", bl, " x ", bw, " x ", bh,
         show_leads ? str("  +リードゾーン ", lead_zone_l) : "",
         "  全長 ", bl + (show_leads ? lead_zone_l : 0)));
