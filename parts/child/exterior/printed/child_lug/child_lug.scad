// =====================================================================
// child_lug.scad — 子機 吊り耳 (ボルトオン小部品、左右共通 ×2)
//
// 外装フレーム再設計 (R4/R8)。旧 child_shell_aft の一体吊り耳を分離した:
//   - 平置き印刷で層が荷重方向に並ぶ (一体型は +Z 印刷で層またぎになる)
//   - スーツケース輸送時は M5 ×2 を外して耳ごと外せる (R4 の解 c)
// コアフレームのラッチ/ヒンジ側フランジ頂部ボス (z=218 面、y -14..0、
// M5 熱圧入インサート ×2 @ x=±16(ボス中心相対), y=-6) へ垂直ボルトで締結。
// 機体では左右 x=±60 に配置。2 点ブライドル (Ø10 ロープ / M10 シャックル)。
//
// 座標系 (部品ローカル): 取付面 = z0 (機体では z=218)。x = 基線方向。
//   耳板は y -24..-12 (機体後方寄り)、シャックルピン軸 = Y。
// 印刷向き: 耳板面 (y=-24) をベッドへ倒して平置き。荷重・ボルト軸とも層面内。
// 荷重: L1 吊り 99 N/耳 (3g)・L2 輸送 600 N: lug 1.6 MPa / 耳板曲げ 18.8 MPa
//   (600N 側方単独ヒット、係数 10 込み) → PASS (quick_strength 済み)
// =====================================================================

/* [取付 (コアフレーム側と二重定義)]
   機体では x=±66 の縦列 2 本 (y=-4/-16)。列が 1 本なのは上ポケット壁 (r60.9)
   の外側に置くため。x=±66 は lf_x1=72 のフランジ内。 */
base_hw   = 20;     // 台座半幅 (x)
base_d    = 33;     // 台座奥行 (y 0..-33)
base_t    = 8;
m5_d      = 5.4;
bolt_y2   = [-4, -16];  // M5 ×2 (x=0 列)

/* [耳板] */
ear_t     = 12;     // 板厚 (y)。y -33..-21
ear_hw    = 20;     // 半幅 (x)
ear_top   = 38;     // 台座上面からの高さ (機体で z=256+... 実際は 218+8+30)
hole_d    = 16;     // Ø10 ロープ / M10 シャックル
hole_z    = 22;     // 台座上面から (機体 z = 248)

/* [Hidden] */
fudge = 0.01;

// ---- 検査 ------------------------------------------------------------
assert(ear_hw - hole_d/2 >= 10,               "耳の横端距離 < 10");
assert(base_t + ear_top - (base_t + hole_z) - hole_d/2 >= 8, "耳の上端距離 < 8");
assert(hole_z - hole_d/2 >= 6,                "穴と台座の距離 < 6");
assert(max(bolt_y2) + m5_d/2 <= -0.5, "M5 が台座前縁に近すぎる");
assert(min(bolt_y2) - 4.3 > -base_d + ear_t + 0.5,
       "M5 頭 (Ø8.5) が耳板に当たる");
echo(str("耳穴 中心 z(機体) = 218 + ", base_t + hole_z, " / 上端 = 218+", base_t + ear_top));

// ---- 形状 ------------------------------------------------------------
difference() {
    union() {
        // 台座
        translate([-base_hw, -base_d, 0]) cube([2*base_hw, base_d, base_t]);
        // 耳板
        translate([-ear_hw, -base_d, base_t - fudge])
            cube([2*ear_hw, ear_t, ear_top - base_t + fudge]);
    }
    // M5 ×2 (垂直、x=0 の縦列)
    for (yy = bolt_y2)
        translate([0, yy, -fudge])
            cylinder(d = m5_d, h = base_t + 2*fudge, $fn = 32);
    // シャックル穴 Ø16 (軸 Y)
    translate([0, -base_d - fudge, base_t + hole_z])
        rotate([-90, 0, 0]) cylinder(d = hole_d, h = ear_t + 2*fudge, $fn = 48);
}
