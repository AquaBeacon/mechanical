// =====================================================================
// xt60_rigid_run.scad — 電源リードの「曲げ不可な硬直区間」簡易キープアウト
//
// 電池側の硬直スリーブ (50mm) + 嵌合した XT60 ペア (電池側プラグ + 変換ケーブル
// 側レセプタクル) + 変換ケーブルのブートを、断面矩形の積み木で近似したモデル。
// 全寸法は推定 — 実測して確定させること (.md 参照)。印刷対象ではない。
//
// 出典: なし (推定値)。
//
// 原点: 底面中心 (0,0,0)。Z = 軸方向、電池側を z=0、変換ケーブル側を z=run_l とする。
//       各区間は X・Y とも Z 軸を中心に置いた cube。
//       z<0 側には可撓リード 60mm が、z>run_l 側には変換ケーブルの可撓線が続く
//       (いずれも本モデルの範囲外)。
// =====================================================================

/* [硬直スリーブ (電池側)] */
sleeve_l = 50;   // 長さ (Z) : z 0..50
sleeve_w = 5;    // 幅 (X)
sleeve_h = 9;    // 高さ (Y)

/* [嵌合した XT60 ペア]  電池側プラグ + 変換ケーブル側レセプタクル */
pair_l = 40;     // 長さ (Z) : z sleeve_l..sleeve_l+pair_l
run_w  = 8.2;    // 幅 (X)
run_h  = 15.6;   // 高さ (Y)

/* [変換ケーブルのブート]  スリーブと同断面 */
boot_l = 5;      // 長さ (Z)

$fn = 32;

// ---- 導出 -----------------------------------------------------------
run_l = sleeve_l + pair_l + boot_l;   // = 95

// ---- 成立性チェック --------------------------------------------------
// スリーブ/ブートの断面は XT60 ペアの断面に収まっていること (段差が逆転しない)
assert(sleeve_w <= run_w && sleeve_h <= run_h,
       str("硬直スリーブ断面 ", sleeve_w, "x", sleeve_h,
           " が XT60 ペア断面 ", run_w, "x", run_h, " を超過"));
assert(run_l > 0, "run_l が正でない");

// ---- 本体 -------------------------------------------------------------
union() {
    // 硬直スリーブ (電池側)
    translate([-sleeve_w / 2, -sleeve_h / 2, 0])
        cube([sleeve_w, sleeve_h, sleeve_l]);

    // 嵌合した XT60 ペア
    translate([-run_w / 2, -run_h / 2, sleeve_l])
        cube([run_w, run_h, pair_l]);

    // 変換ケーブルのブート
    translate([-sleeve_w / 2, -sleeve_h / 2, sleeve_l + pair_l])
        cube([sleeve_w, sleeve_h, boot_l]);
}

echo(str("xt60_rigid_run: 硬直 ", sleeve_l, " + XT60ペア ", pair_l,
         " + ブート ", boot_l, " = ", run_l,
         ", 断面 ", run_w, " x ", run_h));
