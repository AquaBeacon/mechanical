// =====================================================================
// parent_pod_bezel.scad — 親機 カメラポッド ベゼル(窓押えリング)
// parent_pod_body のフランジに M3×6 で締結し、アクリル窓(Ø72×t4)を
// Oリングに押し付ける。窓は裏面ポケットに収まる。
// 印刷向き: 平置き(表面=座グリ側を上)。
// =====================================================================

/* [parent_pod_body と一致させる] */
od        = 94;      // 外径
aperture  = 54;      // 開口Ø (レンズ視野。4mmレンズ+フードで要確認)
t         = 8;       // 厚
win_d     = 76;      // アクリル窓Ø
win_t     = 4;       // 窓厚
win_clear = 0.6;     // 窓ポケット径余裕
squeeze   = 0.6;     // Oリング押し込み量 (窓がフランジ面より浮く分)
m3_bcd    = 84;
m3_d      = 3.4;     // M3クリアランス
head_d    = 6.5;     // M3キャップ頭+余裕
head_t    = 3.2;

$fn = 128;

// ---- 導出 -----------------------------------------------------------
pocket_d  = win_d + win_clear;
pocket_t  = win_t - squeeze;   // 窓はポケット底とOリングに挟まれる

// ---- チェック ---------------------------------------------------------
assert(aperture/2 < win_d/2 - 4, "開口が窓の縁に接近(押え代4mm未満)");
assert(m3_bcd/2 - m3_d/2 > pocket_d/2 + 1, "M3穴が窓ポケットと干渉");
assert(m3_bcd/2 + head_d/2 < od/2 - 1, "M3頭座グリが外周と干渉");
assert(pocket_t > 2 && pocket_t < win_t, "ポケット深さが不正");
assert(t - pocket_t >= 3, "ポケット上の残り肉厚不足");

// ---- 本体 -------------------------------------------------------------
difference() {
    cylinder(d=od, h=t);
    // 開口
    translate([0, 0, -0.5]) cylinder(d=aperture, h=t + 1);
    // 窓ポケット (裏面 = z0 側)
    translate([0, 0, -0.5]) cylinder(d=pocket_d, h=pocket_t + 0.5);
    // M3 ×6 + 座グリ (表面側)
    for (a=[0:60:300]) rotate([0, 0, a]) translate([m3_bcd/2, 0, 0]) {
        translate([0, 0, -0.5]) cylinder(d=m3_d, h=t + 1);
        translate([0, 0, t - head_t]) cylinder(d=head_d, h=head_t + 0.5);
    }
}
